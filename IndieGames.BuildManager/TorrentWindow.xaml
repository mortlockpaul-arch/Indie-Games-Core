<Window x:Class="IndieGames.BuildManager.TorrentWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Project Torrent Catalogue" Width="1050" Height="850" MinWidth="800" MinHeight="650"
 Background="#111827" Foreground="#E5E7EB" Closing="Window_Closing" Loaded="Window_Loaded">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,6"/><Setter Property="Background" Value="#374151"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/><Setter Property="Background" Value="#1F2937"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Margin" Value="4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="8"/></Style>
 </Window.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Project Torrent Catalogue" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="Browse a shared catalogue, download source, a playable Windows game, or select both packages. Keep this window open to seed; closing it stops transfers." TextWrapping="Wrap"/>
   <TextBlock x:Name="CacheNote" Foreground="#9CA3AF" TextWrapping="Wrap" FontSize="11"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Load" Click="LoadCatalogue_Click"/><Button DockPanel.Dock="Right" Content="Open file…" Click="OpenCatalogue_Click"/><TextBox x:Name="CatalogueLocationBox" ToolTip="Catalogue JSON file or HTTP/HTTPS URL"/></DockPanel>
   <WrapPanel><Button Content="My catalogue" Click="MyCatalogue_Click"/><Button Content="Export catalogue…" Click="ExportCatalogue_Click"/><Button Content="Create project share…" Click="ShowShare_Click"/></WrapPanel>
  </StackPanel>
  <StackPanel Grid.Row="1"><DockPanel><TextBlock DockPanel.Dock="Left" Text="Source archive"/><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseArchive_Click"/><TextBox x:Name="ArchiveBox"/></DockPanel><DockPanel><TextBlock Text="Playable games"/><TextBox x:Name="GamesBox"/></DockPanel></StackPanel>
  <DataGrid Grid.Row="2" x:Name="CatalogueGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
   Background="#1F2937" Foreground="#111827" RowBackground="#E5E7EB" AlternatingRowBackground="#D1D5DB" Margin="4">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Project" Binding="{Binding Project.Name}" Width="2*"/>
    <DataGridTextColumn Header="Type" Binding="{Binding Project.PackageKind}" Width="65"/>
    <DataGridTextColumn Header="Package" Binding="{Binding Project.SizeDisplay}" Width="80"/>
    <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="130"/>
    <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="75"/>
    <DataGridTextColumn Header="Peers" Binding="{Binding Peers}" Width="50"/>
    <DataGridTextColumn Header="Down / Up" Binding="{Binding Rates}" Width="155"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3">
   <WrapPanel><Button Content="Download / resume" Click="Download_Click"/><Button Content="Seed selected" Click="Seed_Click"/><Button Content="Pause" Click="Pause_Click"/><Button Content="Stop" Click="Stop_Click"/><Button Content="Verify and install" Click="Install_Click"/><Button Content="Run installed game" Click="RunInstalled_Click"/><Button Content="Open games folder" Click="OpenGames_Click"/><Button Content="Cancel operation" Click="Cancel_Click"/></WrapPanel>
   <WrapPanel><TextBlock Text="TCP/UDP port"/><TextBox x:Name="PortBox" Text="6881" Width="65"/><CheckBox x:Name="PortForwardingBox" Content="Try router port forwarding (UPnP/NAT-PMP)"/><TextBlock x:Name="NetworkNote" Text="DHT and local-peer discovery are used; trackers are optional." Foreground="#9CA3AF"/></WrapPanel>
  </StackPanel>
  <Expander Grid.Row="4" x:Name="SharePanel" Header="Share source, playable game, or both" Foreground="White" Margin="4">
   <StackPanel>
    <ComboBox x:Name="ShareKindBox" SelectedIndex="0" SelectionChanged="ShareKind_Changed"><ComboBoxItem Content="Source"/><ComboBoxItem Content="Playable game"/><ComboBoxItem Content="Both"/></ComboBox>
    <DockPanel><Button DockPanel.Dock="Right" Content="Choose folder…" Click="BrowseShare_Click"/><Button DockPanel.Dock="Right" Content="Preview files" Click="PreviewShare_Click"/><TextBox x:Name="ShareFolderBox" TextChanged="ShareFolder_Changed"/></DockPanel>
    <DockPanel><TextBlock Text="Playable game folder"/><Button DockPanel.Dock="Right" Content="Choose game…" Click="BrowseGame_Click"/><TextBox x:Name="GameFolderBox" TextChanged="ShareFolder_Changed"/></DockPanel>
    <TextBlock Text="Excludes bin, obj, repository metadata, backups, logs, conversion outputs and extracted 584E package folders. Review the file list before creating a share." TextWrapping="Wrap" Foreground="#9CA3AF"/>
    <TextBox x:Name="ShareFilesBox" Height="100" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
    <DockPanel><TextBlock DockPanel.Dock="Left" Text="Trackers (optional; one URL per line)"/><TextBox x:Name="TrackersBox" Height="45" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></DockPanel>
    <WrapPanel><TextBlock x:Name="ShareSummary"/><Button x:Name="CreateShareButton" Content="Create torrent and seed" IsEnabled="False" Click="CreateShare_Click"/></WrapPanel>
   </StackPanel>
  </Expander>
  <TextBox Grid.Row="5" x:Name="StatusBox" IsReadOnly="True" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
 </Grid>
</Window>
