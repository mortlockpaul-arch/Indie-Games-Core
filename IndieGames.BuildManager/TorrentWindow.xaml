<Window x:Class="IndieGames.BuildManager.TorrentWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Project Torrent Catalogue" Width="1050" Height="850" MinWidth="800" MinHeight="650"
 Background="#111827" Foreground="#E5E7EB" Closing="Window_Closing" Loaded="Window_Loaded">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,6"/><Setter Property="Background" Value="#374151"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/><Setter Property="Background" Value="#1F2937"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Margin" Value="4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="8"/></Style>
 </Window.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Project Torrent Catalogue" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="Download or share source and playable Windows games. Closing this window keeps transfers running; monitor them or use Stop Torrents in the main window." TextWrapping="Wrap"/>
   <TextBlock x:Name="CacheNote" Foreground="#9CA3AF" TextWrapping="Wrap" FontSize="11"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Load" Click="LoadCatalogue_Click"/><Button DockPanel.Dock="Right" Content="Open File…" Click="OpenCatalogue_Click"/><TextBox x:Name="CatalogueLocationBox" ToolTip="Catalogue JSON file or HTTP/HTTPS URL"/></DockPanel>
   <WrapPanel><Button Content="My Catalogue" Click="MyCatalogue_Click"/><Button Content="Export Catalogue…" Click="ExportCatalogue_Click"/><Button Content="Create Project Share…" Click="ShowShare_Click"/></WrapPanel>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Source Archive"/>
   <TextBox x:Name="ArchiveBox" Grid.Column="1" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   <Button Grid.Column="2" Content="Browse…" Click="BrowseArchive_Click" ToolTip="Choose the source archive folder"/>
   <TextBlock Grid.Column="3" Text="Playable Games" Margin="12,4,4,4"/>
   <TextBox x:Name="GamesBox" Grid.Column="4" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   <Button Grid.Column="5" Content="Browse…" Click="BrowseGames_Click" ToolTip="Choose the playable games folder"/>
  </Grid>
  <DataGrid Grid.Row="2" x:Name="CatalogueGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
   Background="#1F2937" Foreground="#111827" RowBackground="#E5E7EB" AlternatingRowBackground="#D1D5DB" Margin="4">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Project" Binding="{Binding Project.Name}" Width="2*"/>
    <DataGridTextColumn Header="Type" Binding="{Binding Project.PackageKind}" Width="65"/>
    <DataGridTextColumn Header="Package" Binding="{Binding Project.SizeDisplay}" Width="80"/>
    <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="130"/>
    <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="75"/>
    <DataGridTextColumn Header="Peers" Binding="{Binding Peers}" Width="50"/>
    <DataGridTextColumn Header="Down / Up" Binding="{Binding Rates}" Width="155"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3">
   <WrapPanel><Button Content="Download / Resume" Click="Download_Click"/><Button Content="Seed Selected" Click="Seed_Click"/><Button Content="Pause" Click="Pause_Click"/><Button Content="Stop" Click="Stop_Click"/><Button Content="Remove Selected" Click="Remove_Click" ToolTip="Stop selected transfers and remove their catalogue entries; keep all files"/><Button Content="Verify And Install" Click="Install_Click"/><Button Content="Run Installed Game" Click="RunInstalled_Click"/><Button Content="Open Games Folder" Click="OpenGames_Click"/><Button Content="Cancel Operation" Click="Cancel_Click"/></WrapPanel>
   <WrapPanel><TextBlock Text="TCP/UDP port"/><TextBox x:Name="PortBox" Text="6881" Width="65"/><CheckBox x:Name="PortForwardingBox" Content="Try router port forwarding (UPnP/NAT-PMP)"/><TextBlock x:Name="NetworkNote" Text="DHT and local-peer discovery are used; trackers are optional." Foreground="#9CA3AF"/></WrapPanel>
  </StackPanel>
  <ContentControl Grid.Row="4" x:Name="ShareHost" Visibility="Collapsed">
   <StackPanel>
    <WrapPanel Margin="4,8"><RadioButton x:Name="SourceKindChoice" GroupName="ShareKind" Content="Source" IsChecked="True" Checked="ShareKind_Changed" Foreground="White" Margin="8"/><RadioButton x:Name="GameKindChoice" GroupName="ShareKind" Content="Playable Game" Checked="ShareKind_Changed" Foreground="White" Margin="8"/><RadioButton x:Name="BothKindChoice" GroupName="ShareKind" Content="Both" Checked="ShareKind_Changed" Foreground="White" Margin="8"/></WrapPanel>
    <DockPanel x:Name="SourceShareRow"><TextBlock Text="Source Folder"/><ComboBox x:Name="ShareFolderBox" DisplayMemberPath="Name" SelectedValuePath="Folder" SelectionChanged="ShareFolder_Changed" IsTextSearchEnabled="True" Margin="4" Padding="6" MinWidth="250" ToolTip="Select a game from the source archive"/></DockPanel>
    <DockPanel x:Name="GameShareRow" Visibility="Collapsed"><TextBlock Text="Playable Game Folder (Automatic)"/><TextBox x:Name="GameFolderBox" IsReadOnly="True" ToolTip="Detected from the selected game's build output"/></DockPanel>
    <TextBlock Text="File preview updates automatically when you select a game or change the package type." Foreground="#93C5FD" TextWrapping="Wrap"/>
    <TextBlock Text="Excludes bin, obj, repository metadata, backups, logs, conversion outputs and extracted 584E package folders. Review the file list before creating a share." TextWrapping="Wrap" Foreground="#9CA3AF"/>
    <TextBox x:Name="ShareFilesBox" Height="100" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
    <Expander Header="Optional Trackers" Foreground="White" Margin="4"><TextBox x:Name="TrackersBox" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="One tracker URL per line. Leave blank to use peer discovery."/></Expander>
    <WrapPanel><TextBlock x:Name="ShareSummary"/><Button x:Name="CreateShareButton" Content="Share And Start Seeding" IsEnabled="False" Click="CreateShare_Click"/></WrapPanel>
   </StackPanel>
  </ContentControl>
  <TextBox Grid.Row="5" x:Name="StatusBox" IsReadOnly="True" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
 </Grid>
</Window>
