<Window x:Class="IndieGames.BuildManager.TorrentWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Project Torrent Catalogue" Width="1180" Height="880" MinWidth="960" MinHeight="680"
 Background="#111827" Foreground="#E5E7EB" Closing="Window_Closing" Loaded="Window_Loaded">
 <Window.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/ManagerTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </Window.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Project Torrent Catalogue" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="Download or share source and playable Windows games. Closing this window keeps transfers running; monitor them or use Stop Torrents in the main window." TextWrapping="Wrap"/>
   <TextBlock x:Name="CacheNote" Foreground="#9CA3AF" TextWrapping="Wrap" FontSize="11"/>
   <TextBlock Text="Green rows have a project in your configured solution. Blue marks the current selection." Foreground="#95D5B2" FontSize="11" Margin="0,3"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Load" Click="LoadCatalogue_Click"/><Button DockPanel.Dock="Right" Content="Open File…" Click="OpenCatalogue_Click"/><TextBox x:Name="CatalogueLocationBox" ToolTip="Catalogue JSON file or HTTP/HTTPS URL"/></DockPanel>
   <WrapPanel><Button Content="My Catalogue" Click="MyCatalogue_Click"/><Button Content="Export Catalogue…" Click="ExportCatalogue_Click"/><Button Content="New share…" Click="ShowShare_Click" Background="#2563EB"/><Button Content="Compare snapshots" Click="CompareSnapshots_Click" ToolTip="Select two snapshots of the same game and package type to compare their files"/><Button Content="Help / Getting started" Click="SharingHelp_Click"/></WrapPanel>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Source Archive"/>
   <TextBox x:Name="ArchiveBox" Grid.Column="1" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   <Button Grid.Column="2" Content="Browse…" Click="BrowseArchive_Click" ToolTip="Choose the source archive folder"/>
   <TextBlock Grid.Column="3" Text="Playable Games" Margin="12,4,4,4"/>
   <TextBox x:Name="GamesBox" Grid.Column="4" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   <Button Grid.Column="5" Content="Browse…" Click="BrowseGames_Click" ToolTip="Choose the playable games folder"/>
  </Grid>
  <DataGrid Grid.Row="2" x:Name="CatalogueGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
   RowStyle="{StaticResource ProjectRow}"
   Background="#182234" Foreground="#E5E7EB"  AlternationCount="2" BorderBrush="#374151" HorizontalGridLinesBrush="#2D3B50" GridLinesVisibility="Horizontal" FontSize="13" RowHeight="42" HeadersVisibility="All" RowHeaderWidth="6" SelectionUnit="FullRow" CanUserAddRows="False" SelectionChanged="CatalogueSelection_Changed" Margin="4">
   <DataGrid.Columns>
        <DataGridTemplateColumn Header="Project" SortMemberPath="Project.Name" Width="2*" MinWidth="220">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <DockPanel ToolTip="{Binding Project.Name}">
       <Border DockPanel.Dock="Left" Width="28" Height="28" Background="#263449" CornerRadius="5" Margin="0,0,10,0">
        <Grid><TextBlock Text="◇" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid>
       </Border>
       <TextBlock Text="{Binding Project.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="Package type" Binding="{Binding KindLabel}" Width="115"/>
    <DataGridTextColumn Header="Created" Binding="{Binding Project.CreatedDisplay}" SortMemberPath="Project.CreatedUtc" Width="115"/>
    <DataGridTextColumn Header="Snapshot" Binding="{Binding Project.SnapshotDisplay}" Width="100"/>
    <DataGridTextColumn Header="Package" Binding="{Binding Project.SizeDisplay}" Width="80"/>
    <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="130"/>
    <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="75"/>
    <DataGridTextColumn Header="Peers" Binding="{Binding Peers}" Width="50"/>
    <DataGridTextColumn Header="Down / Up" Binding="{Binding Rates}" Width="155"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3"><TextBlock x:Name="PackageHelpText" Text="Select a package to download, share or install." Foreground="#93C5FD" TextWrapping="Wrap" Margin="4,7"/>
   <WrapPanel><Button Content="Download / Resume" Click="Download_Click"/><Button Content="Seed Selected" Click="Seed_Click"/><Button Content="Pause" Click="Pause_Click"/><Button Content="Stop" Click="Stop_Click"/><Button Content="Remove Selected" Click="Remove_Click" ToolTip="Stop selected transfers and remove their catalogue entries; keep all files"/><Button Content="Verify And Install" Click="Install_Click"/><Button Content="Run Installed Game" Click="RunInstalled_Click"/><Button Content="Open Games Folder" Click="OpenGames_Click"/><Button Content="Cancel Operation" Click="Cancel_Click"/></WrapPanel>
   <WrapPanel><TextBlock Text="TCP/UDP port"/><TextBox x:Name="PortBox" Text="6881" Width="65"/><CheckBox x:Name="PortForwardingBox" Content="Try router port forwarding (UPnP/NAT-PMP)"/><TextBlock x:Name="NetworkNote" Text="DHT and local-peer discovery are used; trackers are optional." Foreground="#9CA3AF"/></WrapPanel>
  </StackPanel>
  <ContentControl Grid.Row="4" x:Name="ShareHost" Visibility="Collapsed">
   <StackPanel Margin="4">
    <TextBlock Text="1  Choose your game" FontSize="16" FontWeight="SemiBold" Margin="4,8"/>
    <DockPanel x:Name="SourceShareRow"><TextBlock Text="Game / port" Margin="4"/><ComboBox x:Name="ShareFolderBox" Style="{StaticResource BuildChoice}" DisplayMemberPath="Name" SelectedValuePath="Folder" SelectionChanged="ShareFolder_Changed" IsTextSearchEnabled="True" Margin="4" MinWidth="250" ToolTip="Choose a project from the archive; type a title to jump to it"/></DockPanel>
    <TextBlock Text="2  Choose what people receive" FontSize="16" FontWeight="SemiBold" Margin="4,14,4,7"/>
    <WrapPanel Margin="4,0"><RadioButton x:Name="SourceKindChoice" GroupName="ShareKind" Content="Source files" IsChecked="True" Checked="ShareKind_Changed" Foreground="White" Margin="8"/><RadioButton x:Name="GameKindChoice" GroupName="ShareKind" Content="Playable game" Checked="ShareKind_Changed" Foreground="White" Margin="8"/><RadioButton x:Name="BothKindChoice" GroupName="ShareKind" Content="Both" Checked="ShareKind_Changed" Foreground="White" Margin="8"/></WrapPanel>
    <TextBlock Text="Source files are for editing and building. A playable game contains the Windows build. Both creates two packages so recipients can choose." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="4,5"/>
    <DockPanel x:Name="GameShareRow" Visibility="Collapsed"><TextBlock Text="Detected Windows build" Margin="4"/><TextBox x:Name="GameFolderBox" IsReadOnly="True" ToolTip="Detected automatically. Build and test the game in the main window before sharing."/></DockPanel>
    <TextBlock Text="3  Review the files, then create your share" FontSize="16" FontWeight="SemiBold" Margin="4,14,4,7"/>
    <TextBlock Text="The preview updates automatically. Source packages leave out build outputs, backups and logs. If files change while this window is open, use Refresh files." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="4,0,4,6"/>
    <Expander Header="Included files" Foreground="#E5E7EB" IsExpanded="True" Margin="4"><TextBox x:Name="ShareFilesBox" Height="110" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/></Expander>
    <TextBlock x:Name="ShareSummary" Foreground="#93C5FD" TextWrapping="Wrap" Margin="4,7"/>
    <Expander Header="Advanced: optional trackers" Foreground="#E5E7EB" Margin="4"><StackPanel><TextBlock Text="Leave this blank to use built-in peer discovery. Add one tracker URL per line only if your group uses trackers." TextWrapping="Wrap" Foreground="#9CA3AF" Margin="4"/><TextBox x:Name="TrackersBox" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></StackPanel></Expander>
    <WrapPanel x:Name="ShareActionsPanel" Margin="0,8"><Button Content="Refresh files" Click="RefreshShare_Click"/><Button x:Name="CreateShareButton" Content="Create share and save catalogue…" Background="#2563EB" IsEnabled="False" Click="CreateShare_Click"/></WrapPanel>
    <TextBlock Text="You will choose where to save a small catalogue (.json) file. Send that file to recipients and keep Build Manager open while they download." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="4"/>
   </StackPanel>
  </ContentControl>
  <TextBox Grid.Row="5" x:Name="StatusBox" IsReadOnly="True" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
 </Grid>
</Window>
