<Window x:Class="IndieGames.BuildManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:IndieGames.BuildManager.Services"
 xmlns:local="clr-namespace:IndieGames.BuildManager"
 Title="Indie Games Build Manager" Height="900" Width="1400" MinWidth="1000" MinHeight="780"
 WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Icon="/IndieGames.BuildManager;component/DashboardIcon.ico"
 Background="#111827" Foreground="#E5E7EB">
 <Window.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/ManagerTheme.xaml"/></ResourceDictionary.MergedDictionaries><local:RuntimeIdentifierDisplayConverter x:Key="RuntimeIdentifierDisplay"/></ResourceDictionary>
 </Window.Resources>
 <DockPanel Margin="16">
   <StackPanel DockPanel.Dock="Top">
     <DockPanel Margin="4,0,4,10"><TextBlock DockPanel.Dock="Right" Text="{x:Static local:AppVersion.Current}" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/><TextBlock x:Name="WindowHeading" Text="INDIE GAMES BUILD MANAGER" FontSize="22" FontWeight="SemiBold" Foreground="#F3F4F6"/></DockPanel>
     <TextBox x:Name="RootBox" Text="D:\indie-game-archive" Visibility="Collapsed"/>
     <DockPanel Margin="2,0,2,4">
      <Button x:Name="ScanProjectsButton" DockPanel.Dock="Left" Content="Scan Projects" Click="Scan_Click" Margin="2,0,10,0" MinWidth="110"/>
      <StackPanel VerticalAlignment="Center"><ProgressBar x:Name="FolderScanProgress" Height="8" Minimum="0" Maximum="100"/><TextBlock x:Name="FolderScanStatus" Text="Ready To Scan" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" FontSize="11"/></StackPanel>
     </DockPanel>
     <WrapPanel Margin="2,0,2,6">
       <Button x:Name="CancelScanButton" Style="{StaticResource ToolbarButton}" Content="Cancel Scan" Click="CancelScan_Click" IsEnabled="False"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Storage…" Click="Storage_Click" ToolTip="Storage folders and build cache cleanup"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Archive Maintenance…" Click="ProjectCleanup_Click" ToolTip="Scan and maintain archive projects, backups, and cleanup reports"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Share Source…" Click="ShareSource_Click" Background="#2563EB" ToolTip="Share the selected game's source files"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Share Game…" Click="ShareGame_Click" Background="#2563EB" ToolTip="Share the selected game's built Windows output"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Share Both…" Click="ShareBoth_Click"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Games / Ports…" Click="PlayableGames_Click"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Catalogue…" Click="TorrentCatalogue_Click"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Merge Catalogue PRs…" Click="MergeCatalogue_Click" ToolTip="Preview and safely merge validated catalogue pull requests as repository administrator"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Close Window" Click="CloseWindow_Click" ToolTip="Close the main window; background seeding continues when enabled"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Exit Build Manager" Click="FullShutdown_Click" ToolTip="Quit Build Manager and stop all transfers"/>
     </WrapPanel>
   </StackPanel>
   <Border DockPanel.Dock="Top" Background="#182234" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="2,0,2,8">
    <DockPanel>
     <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
      <TextBlock Text="ZXBox" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,10,0"/>
      <ComboBox x:Name="ZxBoxBackendBox" Style="{StaticResource BuildChoice}" SelectedIndex="0" Width="115" SelectionChanged="ZxBoxBackend_Changed" ToolTip="Choose the ZXBox desktop renderer. Both use the same Spectrum games and emulator options."><ComboBoxItem Content="FNA"/><ComboBoxItem Content="MonoGame"/></ComboBox>
      <Button x:Name="ZxBoxRunButton" Content="Run ZXBox" Click="ZxBoxRun_Click" ToolTip="Open the Spectrum game browser. Builds the selected launcher if it has not been built yet."/>
      <Button x:Name="ZxBoxBuildButton" Content="Build &amp; Run" Click="ZxBoxBuild_Click" ToolTip="Build the selected ZXBox backend in x64 Release, then open its game browser."/>
      <Button Content="Open Games Folder" Click="ZxBoxGames_Click" ToolTip="Add .z80, .sna, .tap or .tzx files to the ZXBox game library."/>
     </WrapPanel>
     <TextBlock x:Name="ZxBoxStatus" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,3,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </DockPanel>
   </Border>
   <Grid>
     <Grid.RowDefinitions><RowDefinition Height="3*" MinHeight="400"/><RowDefinition Height="6"/><RowDefinition Height="2*" MinHeight="140"/></Grid.RowDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="6*" MinHeight="205"/><RowDefinition Height="5*" MaxHeight="300"/></Grid.RowDefinitions>
     <DockPanel x:Name="GamesRegion" Margin="0,0,0,8">
       <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
        <WrapPanel>
         <TextBlock x:Name="GameSelectionCount" Text="Select games to build or repair" Foreground="#93C5FD" Margin="4"/>
          <Button Content="Check Architecture" Click="Detect_Click" ToolTip="Check configuration and compiled DLL architectures for selected rows"/>
          <Button Content="Open Folder" x:Name="OpenSelectedFolderButton" Click="OpenSelectedFolder_Click" IsEnabled="False"/>
          <Button Content="Bump Version…" x:Name="BumpVersionButton" Click="BumpVersion_Click" IsEnabled="False" ToolTip="Set the executable version for the selected game. Rebuild to apply it."/>
          <Button x:Name="AddToSolutionButton" Content="Add to Solution" Click="AddToSolution_Click" IsEnabled="False"/>
          <Button x:Name="RemoveFromSolutionButton" Content="Remove from Solution" Click="RemoveFromSolution_Click" IsEnabled="False" ToolTip="Remove selected project entries from the solution; keep all project and game files"/>
          <Button Content="Settings…" Click="Storage_Click" ToolTip="Configure the solution path and library folders"/>
         <TextBlock x:Name="SelectedSolutionName" Text="No solution selected" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="6,0"/>
        </WrapPanel>
        <Border Background="#182234" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="6" Margin="3,3,3,0">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="24" Height="24" Margin="0,0,10,0" Background="#263449" CornerRadius="6" VerticalAlignment="Center">
           <Grid><TextBlock Text="◆" Foreground="#93C5FD" HorizontalAlignment="Center" FontSize="20"/>
            <Image x:Name="SelectedGameIcon" Source="{Binding SelectedItem.IconPath, ElementName=ProjectsGrid, Converter={StaticResource GameIcon}}" Width="24" Height="24" Stretch="Uniform"/>
           </Grid>
          </Border>
          <TextBlock Grid.Column="1" x:Name="SelectedGameName" Text="No game selected" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
          <TextBox Grid.Column="2" x:Name="SelectedGameFolderBox" Text="Select a row to see its folder" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="0" FontSize="11" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock Grid.Column="3" x:Name="SelectedGameDetails" Foreground="#9CA3AF" FontSize="11" MaxWidth="280" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
         </Grid>
        </Border>
       </StackPanel>
       <DockPanel DockPanel.Dock="Top" Margin="3,0,3,6">
        <TextBlock DockPanel.Dock="Left" Text="Find a Game" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button DockPanel.Dock="Right" Content="Clear" Click="ClearGameSearch_Click" ToolTip="Show all games" Padding="10,4" Margin="6,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Items.Count, ElementName=ProjectsGrid, StringFormat={}{0} games}" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0,4,0"/>
        <TextBox x:Name="GameSearchBox" TextChanged="GameSearch_Changed" PreviewKeyDown="GameSearch_KeyDown" VerticalContentAlignment="Center" Padding="8,5" ToolTip="Type part of a game name or folder to filter. Ctrl+F focuses search; Enter selects the first result; Escape clears." AutomationProperties.Name="Find a Game"/>
       </DockPanel>
       <DataGrid x:Name="ProjectsGrid" AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="ProjectsGrid_SelectionChanged" IsReadOnly="True"
        RowStyle="{StaticResource ProjectRow}"
        Background="#182234" Foreground="#E5E7EB" AlternationCount="2" FontSize="13"
        BorderBrush="#374151" HorizontalGridLinesBrush="#2D3B50" CanUserAddRows="False"
        HeadersVisibility="All" RowHeaderWidth="6" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="Game / Project" SortMemberPath="Name" Width="2*">
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
           <DockPanel ToolTip="{Binding Name}">
            <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,9,0" Background="#263449" CornerRadius="4">
             <Grid><TextBlock Text="◆" Foreground="#93C5FD" HorizontalAlignment="Center" FontSize="12"/>
              <Image Source="{Binding IconPath, Converter={StaticResource GameIcon}}" Width="24" Height="24" Stretch="Uniform"/>
             </Grid>
            </Border>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
           </DockPanel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTextColumn Header="Framework" Binding="{Binding TargetFramework}" Width="*"/>
         <DataGridTextColumn Header="Project arch" Binding="{Binding PlatformTarget}" Width="100"/>
         <DataGridTextColumn Header="Next build" Binding="{Binding BuildArchitecture}" Width="100"/>
         <DataGridTextColumn Header="Runtime" Width="*"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource RuntimeIdentifierDisplay}"><Binding Path="RuntimeIdentifier"/><Binding Path="PlatformTarget"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn>
         <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="*" MinWidth="280">
          <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding StatusDisplay}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
         </DataGridTextColumn>
        </DataGrid.Columns>
       </DataGrid>
     </DockPanel>
     <TabControl x:Name="BuildRepairTabs" Grid.Row="1" MaxHeight="300" Margin="0,0,0,8" Background="#111827" BorderBrush="#374151">
      <TabItem Header="Build">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextElement.Foreground="#E5E7EB">
        <StackPanel Margin="5">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="155"/><ColumnDefinition Width="155"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Action"/><ComboBox x:Name="ActionBox" Style="{StaticResource BuildChoice}" SelectedIndex="0"><ComboBoxItem Content="Build"/><ComboBoxItem Content="Rebuild"/><ComboBoxItem Content="Clean"/><ComboBoxItem Content="Restore"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Configuration"/><ComboBox x:Name="ConfigBox" Style="{StaticResource BuildChoice}" IsEditable="True" Text="Debug"><ComboBoxItem Content="Debug"/><ComboBoxItem Content="Release"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Architecture"/><ComboBox x:Name="TargetBox" SelectionChanged="BuildArchitecture_Changed" LostKeyboardFocus="BuildArchitecture_Changed" Style="{StaticResource BuildChoice}" IsEditable="True" Text="x64"><ComboBoxItem Content="x64"/><ComboBoxItem Content="x86"/><ComboBoxItem Content="AnyCPU"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="3"><TextBlock Text="Network Backend"/><ComboBox x:Name="NetworkBackendBox" SelectionChanged="BuildProfile_Changed" Style="{StaticResource BuildChoice}" SelectedIndex="0"><ComboBoxItem Content="Project default"/><ComboBoxItem Content="None"/><ComboBoxItem Content="NetStub"/><ComboBoxItem Content="Steamworks"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="4"><TextBlock Text="Game Framework"/><ComboBox x:Name="GameFrameworkBox" Style="{StaticResource BuildChoice}" SelectionChanged="BuildProfile_Changed" SelectedIndex="0"><ComboBoxItem Content="Project default"/><ComboBoxItem Content="FNA"/><ComboBoxItem Content="MonoGame"/><ComboBoxItem Content="XNA → FNA"/></ComboBox></StackPanel>
         </Grid>
         <WrapPanel Margin="0,2">
          <StackPanel x:Name="MonoGamePlatformPanel" MinWidth="160" Visibility="Collapsed"><TextBlock Text="MonoGame Platform"/><ComboBox x:Name="MonoGamePlatformBox" Style="{StaticResource BuildChoice}" SelectionChanged="BuildProfile_Changed" SelectedIndex="0"><ComboBoxItem Content="Project default"/><ComboBoxItem Content="DesktopGL"/><ComboBoxItem Content="WindowsDX"/></ComboBox></StackPanel>
          <StackPanel x:Name="MonoGameVersionPanel" Width="135" Visibility="Collapsed"><TextBlock Text="MonoGame Version"/><TextBox x:Name="MonoGameVersionBox" Text="3.8.1.303" ToolTip="Used when selecting a new MonoGame package; Project default retains the project's existing version."/></StackPanel>
          <StackPanel x:Name="XnaConversionPanel" Margin="8,0" Visibility="Collapsed"><CheckBox Style="{StaticResource RepairCheckBox}" x:Name="ConvertXna3BuildBox" FontSize="14" MinHeight="28" VerticalContentAlignment="Center" Padding="5,0" Content="Convert XNA 3.x APIs Before Build" IsChecked="True" ToolTip="Explicit XNA → FNA source conversion; Python 3.10+ required. Creates a source backup."/><CheckBox Style="{StaticResource RepairCheckBox}" x:Name="ConvertSceneBuildBox" FontSize="14" MinHeight="28" VerticalContentAlignment="Center" Padding="5,0" Content="Repair Supported Scene Captures" ToolTip="Optional back-buffer capture repair for CRON, Avatar Insane Race 3D and Jet Pack War."/></StackPanel>
         </WrapPanel>
         <CheckBox x:Name="PrebuildXnaRedirectBox" Style="{StaticResource RepairCheckBox}" Margin="8,2" Content="Redirect Compatible XNA DLLs Before Build" ToolTip="Verifies original game DLLs, creates patched copies, backs up and updates project references before compilation. Originals are preserved."/>
         <CheckBox x:Name="AutoXnaRedirectBox" Style="{StaticResource RepairCheckBox}" Margin="8,2" Content="Redirect Compatible XNA DLLs After Successful Build" ToolTip="Opt-in: scans original game DLLs, verifies against FNA, patches copies and installs into the selected architecture output."/>
         <TextBlock x:Name="BuildProfileNote" Text="Select a project to see its framework and available build options." TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#93C5FD" FontSize="11" Margin="5,1"/>
         <WrapPanel VerticalAlignment="Top" ItemHeight="38">
          <Button Style="{StaticResource BuildAction}" Content="Build" Click="Build_Click" Background="#2563EB"/>
          <Button Style="{StaticResource BuildAction}" x:Name="RunGameButton" Content="Run Game" Click="RunGameButton_Click"/>
          <Button Style="{StaticResource BuildAction}" Content="Cancel" Click="Cancel_Click"/>
          <Button Content="Save Architecture to Selected Projects" Click="SaveArchitecture_Click" ToolTip="Save compiler architecture and default platform with backups. Build choices are temporary until saved; rebuild afterward."/>
         </WrapPanel>
         <Expander Header="Advanced build settings" Foreground="#E5E7EB" Margin="4,4,3,2" HorizontalAlignment="Left" VerticalAlignment="Top" IsExpanded="False">
          <StackPanel Margin="4,4,0,3" Width="480">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Runtime override" VerticalAlignment="Center" ToolTip="Leave blank for automatic win-x86 / win-x64 selection."/>
            <TextBox x:Name="RuntimeBox" Grid.Column="1" Text="" ToolTip="Optional runtime override. Leave blank to derive it from Architecture."/>
           </Grid>
           <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Framework override" VerticalAlignment="Center"/>
            <TextBox x:Name="FrameworkBox" Grid.Column="1"/>
           </Grid>
           <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="DefineConstants" VerticalAlignment="Center"/>
            <TextBox x:Name="DefineConstantsBox" Grid.Column="1" ToolTip="Semicolon-separated symbols. Replaces project-defined symbols."/>
           </Grid>
           <WrapPanel Margin="0,4,0,0">
            <CheckBox x:Name="NoRestoreBox" Content="Skip Restore" Margin="4"/>
            <CheckBox x:Name="UseVsBox" Content="Use Visual Studio MSBuild" Margin="4"/>
           </WrapPanel>
           <TextBox x:Name="MsbuildPathBox" Margin="0,4,0,0" ToolTip="Full path to MSBuild.exe"/>
           <Button Content="Inspect Properties" Click="Inspect_Click" HorizontalAlignment="Left" Margin="0,4,0,0"/>
          </StackPanel>
         </Expander>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Repairs">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextElement.Foreground="#E5E7EB">
        <StackPanel Margin="7">
         <StackPanel.Resources>
          <Style x:Key="RepairRow" TargetType="DockPanel">
           <Setter Property="Margin" Value="0,0,0,2"/>
           <Setter Property="Background" Value="#182235"/>
          </Style>
          <Style x:Key="RepairAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
           <Setter Property="Width" Value="176"/>
           <Setter Property="Margin" Value="3,2,8,2"/>
           <Setter Property="Padding" Value="5,2"/>
           <Setter Property="HorizontalContentAlignment" Value="Left"/>
           <Setter Property="DockPanel.Dock" Value="Left"/>
          </Style>
          <Style x:Key="RepairDetail" TargetType="TextBlock">
           <Setter Property="Foreground" Value="#B8C6DC"/>
           <Setter Property="FontSize" Value="11"/>
           <Setter Property="VerticalAlignment" Value="Center"/>
           <Setter Property="TextWrapping" Value="Wrap"/>
           <Setter Property="Margin" Value="0,2,6,2"/>
          </Style>
         </StackPanel.Resources>
         <TextBlock Text="Select one or more games above. Repairs back up originals. Rebuild after applying changes."
                    Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="3,0,3,5"/>
         <DockPanel Style="{StaticResource RepairRow}">
          <Button Content="Open Repair Center…" Click="BatchXnaFixes_Click" Style="{StaticResource RepairAction}" Background="#2563EB"/>
          <TextBlock Style="{StaticResource RepairDetail}" Text="Choose source and SDK repairs, then preview or apply them."/>
         </DockPanel>
         <DockPanel Style="{StaticResource RepairRow}">
          <StackPanel Orientation="Horizontal"><Button Content="Scan XNA DLLs" Click="ScanXnaDlls_Click" Style="{StaticResource RepairAction}"/><Button Content="Patch XNA DLLs" Click="PatchXnaDlls_Click" Style="{StaticResource RepairAction}"/></StackPanel>
          <TextBlock Style="{StaticResource RepairDetail}" Text="Discover legacy XNA assembly references, preview or patch compatible DLLs for the selected build architecture."/>
         </DockPanel>
         <DockPanel Style="{StaticResource RepairRow}">
          <Button Content="Repair XNB References…" Click="RepairXnbReferences_Click" Style="{StaticResource RepairAction}"/>
          <TextBlock Style="{StaticResource RepairDetail}" Text="Preview or repair XNB content-reader assembly names for selected games. Source deletion is not supported by this fixer yet."/>
         </DockPanel>
         <DockPanel Style="{StaticResource RepairRow}">
          <Button x:Name="InstallOverlayButton" Content="Add F1 Settings Overlay" Click="InstallOverlay_Click" Style="{StaticResource RepairAction}" ToolTip="{Binding Text, ElementName=OverlayAvailabilityNote}"/>
          <StackPanel VerticalAlignment="Center">
           <TextBlock Style="{StaticResource RepairDetail}" Text="Add an in-game settings menu to compatible projects."/>
           <TextBlock x:Name="OverlayAvailabilityNote" Visibility="Collapsed" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,2,6,2"/>
          </StackPanel>
         </DockPanel>
         <DockPanel Style="{StaticResource RepairRow}">
          <Button Content="Convert Compiled XNA Game…" Click="ConvertXnaBinary_Click" Style="{StaticResource RepairAction}"/>
          <TextBlock Style="{StaticResource RepairDetail}" Text="Use XnaToFna to convert an original compiled game in a separate folder."/>
         </DockPanel>
         <TextBlock Text="Game content" FontWeight="SemiBold" Margin="3,5,0,3"/>
         <DockPanel Style="{StaticResource RepairRow}">
          <Button Content="Repair Shaders" Click="RepairKnownShaders_Click" Style="{StaticResource RepairAction}"/>
          <Button Content="Preview demos" Click="ShaderDemos_Click" DockPanel.Dock="Right" VerticalAlignment="Center"/>
          <TextBlock Style="{StaticResource RepairDetail}" Text="Repair known Windows shaders and RoundLine buffer counts."/>
         </DockPanel>
         <DockPanel Style="{StaticResource RepairRow}">
          <Button Content="Recover HLSL + Compile" Click="RecoverShaders_Click" Style="{StaticResource RepairAction}"/>
          <TextBlock Style="{StaticResource RepairDetail}" Text="Recover and compile effects for review; does not replace game XNBs."/>
         </DockPanel>
         <DockPanel Style="{StaticResource RepairRow}">
          <Button Content="Package / Deploy Recovered Shaders" Click="PackageRecoveredShaders_Click" Style="{StaticResource RepairAction}"/>
          <TextBlock Style="{StaticResource RepairDetail}" Text="Verify original hashes, package Windows XNBs; optionally deploy with backups and confirmation."/>
         </DockPanel>
         <DockPanel Style="{StaticResource RepairRow}">
          <Button Content="Convert Audio" Click="ConvertXnbAudio_Click" Style="{StaticResource RepairAction}"/>
          <TextBlock Style="{StaticResource RepairDetail}" Text="Convert Song and SoundEffect XNBs to Windows formats."/>
         </DockPanel>
         <DockPanel Style="{StaticResource RepairRow}">
          <Button Content="Convert Videos" Click="ConvertVideos_Click" Style="{StaticResource RepairAction}"/>
          <TextBlock Style="{StaticResource RepairDetail}" Text="Convert videos to FNA-compatible OGV. Keeps the originals."/>
         </DockPanel>
         <DockPanel Style="{StaticResource RepairRow}">
          <Button Content="Convert Wave Banks" Click="ConvertWaveBanks_Click" Style="{StaticResource RepairAction}"/>
          <TextBlock Style="{StaticResource RepairDetail}" Text="Convert supported XACT wave banks to PCM."/>
         </DockPanel>
         <DockPanel Style="{StaticResource RepairRow}">
          <Button Content="Convert Fonts" Click="ConvertXnbFonts_Click" Style="{StaticResource RepairAction}"/>
          <TextBlock Style="{StaticResource RepairDetail}" Text="Convert SpriteFonts to Windows XNB."/>
         </DockPanel>
         <DockPanel Style="{StaticResource RepairRow}">
          <Button Content="Convert Textures" Click="ConvertXnbTextures_Click" Style="{StaticResource RepairAction}"/>
          <TextBlock Style="{StaticResource RepairDetail}" Text="Convert supported Xbox textures to Windows XNB."/>
         </DockPanel>
         <Expander Header="Conversion tools and options" Foreground="#E5E7EB" Margin="3,3,3,2">
          <StackPanel Margin="0,7,0,0">
           <TextBlock Text="XNB extractor"/><TextBox x:Name="EffectsExtractorBox" Text="C:\source\xnb-extractor\bin\x64\Release\net9.0-windows\XnbExtractor.exe"/>
           <TextBlock Text="FFmpeg"/><TextBox x:Name="AudioFfmpegBox"/>
           <TextBlock Text="Wave bank decoder"/><TextBox x:Name="WaveBankDecoderBox"/>
           <TextBlock Text="XNA effect decompiler project"/><TextBox x:Name="ShaderDecompilerBox" Text="C:\source\Indie-Games-Core\tools\XnaEffectDecompiler\XnaEffectDecompiler.csproj"/>
           <WrapPanel><CheckBox x:Name="ShaderRecoveryRecurseBox" Content="Recover subfolders" IsChecked="True" Margin="5"/><CheckBox x:Name="ShaderRecoveryOverwriteBox" Content="Replace previous recovered output" Margin="5"/></WrapPanel>
           <CheckBox x:Name="ShaderDeployBox" Content="Deploy packaged effects to Content (requires confirmation; backs up originals)" Margin="5"/>
           <TextBlock Text="Effect conversion script"/><TextBox x:Name="EffectsScriptBox" Text="C:\PycharmProjects\xenia-game-manager\src\scripts\Convert-XnbEffects.ps1"/>
           <WrapPanel><CheckBox x:Name="EffectsRecurseBox" Content="Include subfolders" IsChecked="True" Margin="5"/><CheckBox x:Name="EffectsOverwriteBox" Content="Overwrite effects" Margin="5"/></WrapPanel>
           <Button Content="Convert other effects" Click="ConvertXnbEffects_Click" HorizontalAlignment="Left"/>
           <TextBlock Text="Custom fixer script" Margin="0,8,0,0"/><TextBox x:Name="ScriptBox" Text="C:\PycharmProjects\xenia-game-manager\src\scripts\fix_sdk1005.ps1"/>
           <Button Content="Run custom fixer" Click="Fixer_Click" HorizontalAlignment="Left"/>
          </StackPanel>
         </Expander>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Diagnostics">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="7" TextElement.Foreground="#E5E7EB">
        <TextBlock Text="Check selected games" FontSize="16" FontWeight="SemiBold" Margin="3,2,0,8"/>
        <Button Content="Check configuration and architecture" Click="Detect_Click" HorizontalAlignment="Left"/>
        <TextBlock Text="Add logging" FontWeight="SemiBold" Margin="3,14,0,5"/>
        <TextBlock Text="Adds diagnostics to source. Rebuild to include them." Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="3,0,3,6"/>
        <WrapPanel>
         <Button Content="Startup logging" Click="InjectStartup_Click"/>
         <Button Content="FNA versions" Click="InjectFnaVersions_Click"/>
         <Button Content="Game logger" Click="InstallGameLoggerButton_Click"/>
         <Button Content="Fix window title" Click="RepairWindowTitle_Click" ToolTip="Set the selected game's Window.Title and assembly title to its AssemblyName, with backups. Rebuild afterward."/>
         <Button Content="Open game logs" Click="OpenGameLogs_Click" ToolTip="Run game captures Console.WriteLine, stderr and exit information here."/>
         <Button Content="XNA DLL repair help" Click="XnaRepairHelp_Click" ToolTip="How XnaAssemblyRedirector fixes legacy library references, and its limits."/>
        </WrapPanel>
       </StackPanel>
       </ScrollViewer>
      </TabItem>
     </TabControl>
     </Grid>
     <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#374151" ToolTip="Drag to resize the game list and build output / torrents"/>
     <DockPanel x:Name="OutputRegion" Grid.Row="2">
       <StackPanel DockPanel.Dock="Top">
         <DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="StartTorrentsButton" Content="Start / Resume Torrents" Click="StartTorrents_Click" Background="#2563EB" ToolTip="Resume saved downloads and seed local packages. If nothing is saved, open the catalogue to choose a project."/><Button Content="Catalogue…" Click="TorrentCatalogue_Click"/><Button x:Name="StopTorrentsButton" Content="Stop Torrents" Click="StopTorrents_Click" IsEnabled="False"/></WrapPanel><TextBlock x:Name="TorrentSummary" Text="No Active Torrents" Foreground="#93C5FD" TextWrapping="Wrap" Margin="4"/></DockPanel>
         <TextBlock x:Name="TorrentActivity" Foreground="#9CA3AF" Margin="4,0,4,4" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <TabControl x:Name="OutputTabs">
        <TabItem Header="Build Output">
       <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </TabItem>
        <TabItem Header="Torrents">
         <DataGrid x:Name="TorrentTransfersGrid" ToolTip="Select a torrent to select its matching local game. Transfers continue while the catalogue is closed." SelectionChanged="TorrentTransfersGrid_SelectionChanged" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#374151" BorderThickness="1" RowHeaderWidth="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#182234" Foreground="#E5E7EB" AlternationCount="2" FontSize="13" HorizontalGridLinesBrush="#2D3B50">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="2*"/>
           <DataGridTextColumn Header="Package" Binding="{Binding Kind}" Width="110"/>
           <DataGridTextColumn Header="Version" Binding="{Binding VersionDisplay}" Width="110"/>
           <DataGridTextColumn Header="Downloads" Binding="{Binding CompletedDownloadsDisplay}" SortMemberPath="CompletedDownloads" Width="85"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="Completed downloads reported by a tracker. A dash means no tracker count is available."/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
           <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/>
           <DataGridTextColumn Header="Progress" Binding="{Binding ProgressDisplay}" Width="80"/>
           <DataGridTextColumn Header="Peers" Binding="{Binding Peers}" Width="55"/>
           <DataGridTextColumn Header="Download" Binding="{Binding DownloadDisplay}" Width="90"/>
           <DataGridTextColumn Header="Upload" Binding="{Binding UploadDisplay}" Width="90"/>
          </DataGrid.Columns>
         </DataGrid>
        </TabItem>
       </TabControl>
     </DockPanel>
   </Grid>
 </DockPanel>
</Window>
