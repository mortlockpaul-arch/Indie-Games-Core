<Window x:Class="IndieGames.BuildManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:IndieGames.BuildManager.Services"
 Title="Indie Games Build Manager" WindowState="Maximized" Height="850" Width="1400" MinWidth="1000" MinHeight="660"
 WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Icon="/IndieGames.BuildManager;component/DashboardIcon.ico"
 Background="#111827" Foreground="#E5E7EB">
 <Window.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/ManagerTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </Window.Resources>
 <DockPanel Margin="16">
   <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="INDIE GAMES BUILD MANAGER" FontSize="23" FontWeight="Bold" Margin="4,0,0,12"/>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="Archive directory" Margin="4"/>
       <TextBox x:Name="RootBox" Grid.Column="1" Text="D:\indie-game-archive"/>
       <Button Grid.Column="2" Content="Browse..." Click="Browse_Click"/>
       <Button Grid.Column="3" Content="Scan Projects" Click="Scan_Click"/>
     </Grid>
     <StackPanel Margin="4,0,4,2"><ProgressBar x:Name="FolderScanProgress" Height="8" Minimum="0" Maximum="100"/><TextBlock x:Name="FolderScanStatus" Text="Ready To Scan" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" FontSize="11"/></StackPanel>
     <WrapPanel Margin="2,0,2,6">
       <Button x:Name="CancelScanButton" Style="{StaticResource ToolbarButton}" Content="Cancel Scan" Click="CancelScan_Click" IsEnabled="False"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Storage Cleanup…" Click="Storage_Click" ToolTip="Storage folders and build cache cleanup"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Project Cleanup…" Click="ProjectCleanup_Click" ToolTip="Review redundant archive projects and backup files"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Share Source…" Click="ShareSource_Click" Background="#2563EB" ToolTip="Share the selected game's source files"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Share Playable Game…" Click="ShareGame_Click" Background="#2563EB" ToolTip="Share the selected game's built Windows output"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Share Both…" Click="ShareBoth_Click"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Playable Games / Ports…" Click="PlayableGames_Click"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Torrent Manager…" Click="TorrentCatalogue_Click"/>
     </WrapPanel>
   </StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*" MinHeight="110" MaxHeight="220"/></Grid.RowDefinitions>
     <DockPanel Grid.Column="0" Margin="0,0,10,10">
       <TextBlock DockPanel.Dock="Top" Text="Games" FontSize="16" FontWeight="SemiBold" Margin="4,0,0,6"/>
       <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
        <DockPanel>
         <WrapPanel DockPanel.Dock="Right">
          <Button Content="Check architecture" Click="Detect_Click" ToolTip="Check configuration and compiled DLL architectures for selected rows"/>
          <Button Content="Open folder" x:Name="OpenSelectedFolderButton" Click="OpenSelectedFolder_Click" IsEnabled="False"/>
         </WrapPanel>
         <TextBlock x:Name="GameSelectionCount" Text="Select games to build or repair" Foreground="#93C5FD" Margin="4"/>
        </DockPanel>
        <DockPanel Margin="0,2,0,2">
         <WrapPanel DockPanel.Dock="Left">
          <Button x:Name="AddToSolutionButton" Content="Add to solution" Click="AddToSolution_Click" IsEnabled="False"/>
          <Button x:Name="RemoveFromSolutionButton" Content="Remove from solution" Click="RemoveFromSolution_Click" IsEnabled="False" ToolTip="Remove selected project entries from the solution; keep all project and game files"/>
          <Button Content="Settings…" Click="Storage_Click" ToolTip="Configure the solution path and library folders"/>
         </WrapPanel>
         <TextBlock x:Name="SelectedSolutionName" Text="No solution selected" Foreground="#9CA3AF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="6,0"/>
        </DockPanel>
        <Border Background="#182234" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="9" Margin="3,3,3,0">
         <DockPanel>
          <Border DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,10,0" Background="#263449" CornerRadius="6" VerticalAlignment="Center">
           <Grid><TextBlock Text="◆" Foreground="#93C5FD" HorizontalAlignment="Center" FontSize="20"/>
            <Image x:Name="SelectedGameIcon" Source="{Binding SelectedItem.IconPath, ElementName=ProjectsGrid, Converter={StaticResource GameIcon}}" Width="40" Height="40" Stretch="Uniform"/>
           </Grid>
          </Border>
         <StackPanel>
          <TextBlock x:Name="SelectedGameName" Text="No game selected" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBox x:Name="SelectedGameFolderBox" Text="Select a row to see its folder" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,4,0,3" FontSize="11"/>
          <TextBlock x:Name="SelectedGameDetails" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap"/>
         </StackPanel>
         </DockPanel>
        </Border>
       </StackPanel>
       <DataGrid x:Name="ProjectsGrid" AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="ProjectsGrid_SelectionChanged" IsReadOnly="True"
        RowStyle="{StaticResource ProjectRow}"
        Background="#182234" Foreground="#E5E7EB" AlternationCount="2" FontSize="13"
        BorderBrush="#374151" HorizontalGridLinesBrush="#2D3B50" CanUserAddRows="False"
        HeadersVisibility="All" RowHeaderWidth="6" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="Game / Project" SortMemberPath="Name" Width="2*">
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
           <DockPanel ToolTip="{Binding Name}">
            <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,9,0" Background="#263449" CornerRadius="4">
             <Grid><TextBlock Text="◆" Foreground="#93C5FD" HorizontalAlignment="Center" FontSize="12"/>
              <Image Source="{Binding IconPath, Converter={StaticResource GameIcon}}" Width="24" Height="24" Stretch="Uniform"/>
             </Grid>
            </Border>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
           </DockPanel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTextColumn Header="Framework" Binding="{Binding TargetFramework}" Width="*"/>
         <DataGridTextColumn Header="Project arch" Binding="{Binding PlatformTarget}" Width="100"/>
         <DataGridTextColumn Header="Next build" Binding="{Binding BuildArchitecture}" Width="100"/>
         <DataGridTextColumn Header="Runtime" Binding="{Binding RuntimeIdentifier}" Width="*"/>
         <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
     </DockPanel>
     <TabControl Grid.Column="1" Margin="0,0,0,10" Background="#111827" BorderBrush="#374151">
      <TabItem Header="Build">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextElement.Foreground="#E5E7EB">
        <StackPanel Margin="7">
         <TextBlock Text="Build selected games" FontSize="16" FontWeight="SemiBold" Margin="3,2,0,8"/>
         <Grid HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" MaxWidth="340">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Action"/><ComboBox x:Name="ActionBox" Style="{StaticResource BuildChoice}" SelectedIndex="0"><ComboBoxItem Content="Build"/><ComboBoxItem Content="Rebuild"/><ComboBoxItem Content="Clean"/><ComboBoxItem Content="Restore"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Configuration"/><ComboBox x:Name="ConfigBox" Style="{StaticResource BuildChoice}" IsEditable="True" Text="Debug"><ComboBoxItem Content="Debug"/><ComboBoxItem Content="Release"/></ComboBox></StackPanel>
          <StackPanel Grid.Row="1"><TextBlock Text="Platform"/><ComboBox x:Name="PlatformBox" SelectionChanged="BuildArchitecture_Changed" LostKeyboardFocus="BuildArchitecture_Changed" Style="{StaticResource BuildChoice}" IsEditable="True" Text="x64"><ComboBoxItem Content="x64"/><ComboBoxItem Content="x86"/><ComboBoxItem Content="AnyCPU"/></ComboBox></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Compiler target"/><ComboBox x:Name="TargetBox" SelectionChanged="BuildArchitecture_Changed" LostKeyboardFocus="BuildArchitecture_Changed" Style="{StaticResource BuildChoice}" IsEditable="True" Text="x64"><ComboBoxItem Content="x64"/><ComboBoxItem Content="x86"/><ComboBoxItem Content="AnyCPU"/></ComboBox></StackPanel>
          <StackPanel Grid.Row="2"><TextBlock Text="Network backend"/><ComboBox x:Name="NetworkBackendBox" Style="{StaticResource BuildChoice}" SelectedIndex="0"><ComboBoxItem Content="NetStub"/><ComboBoxItem Content="Steamworks"/><ComboBoxItem Content="LiteNetLib" IsEnabled="False"/></ComboBox></StackPanel>
         </Grid>
         <Button Content="Save architecture to selected projects" Click="SaveArchitecture_Click" HorizontalAlignment="Left" ToolTip="Save the compiler architecture and default platform to the selected .csproj files, with backups"/>
         <TextBlock Text="Build choices are temporary until saved. Rebuild after saving." Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="3,2,3,4"/>
         <WrapPanel Margin="0,6,0,4">
          <Button Style="{StaticResource BuildAction}" Content="Build" Click="Build_Click" Background="#2563EB"/>
          <Button Style="{StaticResource BuildAction}" x:Name="RunGameButton" Content="Run game" Click="RunGameButton_Click"/>
          <Button Style="{StaticResource BuildAction}" Content="Cancel" Click="Cancel_Click"/>
         </WrapPanel>
         <Expander Header="Advanced build settings" Foreground="#E5E7EB" Margin="3,8">
          <StackPanel Margin="0,7,0,0">
           <TextBlock Text="Framework override"/><TextBox x:Name="FrameworkBox"/>
           <TextBlock Text="Runtime identifier override"/><TextBox x:Name="RuntimeBox"/>
           <TextBlock Text="DefineConstants override"/><TextBox x:Name="DefineConstantsBox" ToolTip="Semicolon-separated symbols. Replaces project-defined symbols."/>
           <CheckBox x:Name="NoRestoreBox" Content="Skip restore" Margin="5"/>
           <CheckBox x:Name="UseVsBox" Content="Use Visual Studio MSBuild" Margin="5"/>
           <TextBox x:Name="MsbuildPathBox" ToolTip="Full path to MSBuild.exe"/>
           <Button Content="Inspect properties" Click="Inspect_Click" HorizontalAlignment="Left"/>
          </StackPanel>
         </Expander>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Repairs">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextElement.Foreground="#E5E7EB">
        <StackPanel Margin="7">
         <TextBlock Text="Repair selected games" FontSize="16" FontWeight="SemiBold" Margin="3,2,0,6"/>
         <TextBlock Text="Select rows in the grid. Ctrl or Shift selects multiple games. Originals are backed up; rebuild after repairs." TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="11" Margin="3,0,3,9"/>
         <Button Content="Source and SDK repairs…" Click="BatchXnaFixes_Click" HorizontalAlignment="Left" Background="#2563EB"/>
         <Button Content="Add F1 settings overlay" Click="InstallOverlay_Click" HorizontalAlignment="Left" ToolTip="Install backed-up F1 settings hooks in supported .NET 9+ FNA or MonoGame source games. Rebuild afterward."/>
         <Button Content="Convert compiled XNA game…" Click="ConvertXnaBinary_Click" ToolTip="Convert an original compiled game in a separate folder using XnaToFna."/>
         <TextBlock Text="Content" FontWeight="SemiBold" Margin="3,12,0,5"/>
         <WrapPanel>
          <Button Content="Shaders" Click="RepairKnownShaders_Click" ToolTip="Repair known Windows shaders and RoundLine buffer counts"/>
          <Button Content="Shader demos" Click="ShaderDemos_Click" ToolTip="Browse animated previews of all supported shader repairs"/>
          <Button Content="Audio" Click="ConvertXnbAudio_Click" ToolTip="Convert audio XNBs throughout Content to Windows formats"/>
          <Button Content="Videos" Click="ConvertVideos_Click" ToolTip="Convert WMV and common video files to FNA-compatible Theora/Vorbis OGV; originals are retained"/>
          <Button Content="Wave banks" Click="ConvertWaveBanks_Click" ToolTip="Convert supported XACT wave banks to PCM"/>
          <Button Content="Fonts" Click="ConvertXnbFonts_Click" ToolTip="Convert SpriteFonts to Windows XNB"/>
          <Button Content="Textures" Click="ConvertXnbTextures_Click" ToolTip="Convert supported Xbox textures to Windows XNB"/>
         </WrapPanel>
         <Expander Header="Conversion tools and options" Foreground="#E5E7EB" Margin="3,12,3,4">
          <StackPanel Margin="0,7,0,0">
           <TextBlock Text="XNB extractor"/><TextBox x:Name="EffectsExtractorBox" Text="C:\source\xnb-extractor\bin\x64\Release\net9.0-windows\XnbExtractor.exe"/>
           <TextBlock Text="FFmpeg"/><TextBox x:Name="AudioFfmpegBox"/>
           <TextBlock Text="Wave bank decoder"/><TextBox x:Name="WaveBankDecoderBox"/>
           <TextBlock Text="Effect conversion script"/><TextBox x:Name="EffectsScriptBox" Text="C:\PycharmProjects\xenia-game-manager\src\scripts\Convert-XnbEffects.ps1"/>
           <WrapPanel><CheckBox x:Name="EffectsRecurseBox" Content="Include subfolders" IsChecked="True" Margin="5"/><CheckBox x:Name="EffectsOverwriteBox" Content="Overwrite effects" Margin="5"/></WrapPanel>
           <Button Content="Convert other effects" Click="ConvertXnbEffects_Click" HorizontalAlignment="Left"/>
           <TextBlock Text="Custom fixer script" Margin="0,8,0,0"/><TextBox x:Name="ScriptBox" Text="C:\PycharmProjects\xenia-game-manager\src\scripts\fix_sdk1005.ps1"/>
           <Button Content="Run custom fixer" Click="Fixer_Click" HorizontalAlignment="Left"/>
          </StackPanel>
         </Expander>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="Diagnostics">
       <StackPanel Margin="7" TextElement.Foreground="#E5E7EB">
        <TextBlock Text="Check selected games" FontSize="16" FontWeight="SemiBold" Margin="3,2,0,8"/>
        <Button Content="Check configuration and architecture" Click="Detect_Click" HorizontalAlignment="Left"/>
        <TextBlock Text="Add logging" FontWeight="SemiBold" Margin="3,14,0,5"/>
        <TextBlock Text="Adds diagnostics to source. Rebuild to include them." Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="3,0,3,6"/>
        <WrapPanel>
         <Button Content="Startup logging" Click="InjectStartup_Click"/>
         <Button Content="FNA versions" Click="InjectFnaVersions_Click"/>
         <Button Content="Game logger" Click="InstallGameLoggerButton_Click"/>
         <Button Content="Fix window title" Click="RepairWindowTitle_Click" ToolTip="Set the selected game's Window.Title and assembly title to its AssemblyName, with backups. Rebuild afterward."/>
         <Button Content="Open game logs" Click="OpenGameLogs_Click" ToolTip="Run game captures Console.WriteLine, stderr and exit information here."/>
         <Button Content="XNA DLL repair help" Click="XnaRepairHelp_Click" ToolTip="How XnaAssemblyRedirector fixes legacy library references, and its limits."/>
        </WrapPanel>
       </StackPanel>
      </TabItem>
     </TabControl>
     <DockPanel Grid.Row="1" Grid.ColumnSpan="2">
       <StackPanel DockPanel.Dock="Top">
         <DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="View Torrents" Click="ViewTorrents_Click"/><Button x:Name="StopTorrentsButton" Content="Stop Torrents" Click="StopTorrents_Click" IsEnabled="False"/></WrapPanel><TextBlock x:Name="TorrentSummary" Text="No Active Torrents" Foreground="#93C5FD" TextWrapping="Wrap" Margin="4"/></DockPanel>
         <TextBlock x:Name="TorrentActivity" Foreground="#9CA3AF" Margin="4,0,4,4" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <TabControl x:Name="OutputTabs">
        <TabItem Header="Build Output">
       <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </TabItem>
        <TabItem Header="Torrents">
         <DataGrid x:Name="TorrentTransfersGrid" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#374151" BorderThickness="1" RowHeaderWidth="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#182234" Foreground="#E5E7EB" AlternationCount="2" FontSize="13" HorizontalGridLinesBrush="#2D3B50">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="2*"/>
           <DataGridTextColumn Header="Package" Binding="{Binding Kind}" Width="110"/>
           <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/>
           <DataGridTextColumn Header="Progress" Binding="{Binding ProgressDisplay}" Width="80"/>
           <DataGridTextColumn Header="Peers" Binding="{Binding Peers}" Width="55"/>
           <DataGridTextColumn Header="Download" Binding="{Binding DownloadDisplay}" Width="90"/>
           <DataGridTextColumn Header="Upload" Binding="{Binding UploadDisplay}" Width="90"/>
          </DataGrid.Columns>
         </DataGrid>
        </TabItem>
       </TabControl>
     </DockPanel>
   </Grid>
 </DockPanel>
</Window>
