<Window x:Class="IndieGames.BuildManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Indie Games Build Manager" Height="790" Width="1300" MinWidth="950" MinHeight="620"
 Background="#111827" Foreground="#E5E7EB">
 <Window.Resources>
   <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="#374151"/><Setter Property="Foreground" Value="White"/></Style>
   <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="2,3"/><Setter Property="Padding" Value="9,4"/><Setter Property="MinHeight" Value="28"/></Style>
   <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="7"/><Setter Property="Background" Value="#1F2937"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4B5563"/></Style>
   <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F9FAFB"/></Style>
   <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/></Style>
   <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <DockPanel Margin="16">
   <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="INDIE GAMES BUILD MANAGER" FontSize="23" FontWeight="Bold" Margin="4,0,0,12"/>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="Archive directory" Margin="4"/>
       <TextBox x:Name="RootBox" Grid.Column="1" Text="D:\indie-game-archive"/>
       <Button Grid.Column="2" Content="Browse..." Click="Browse_Click"/>
       <Button Grid.Column="3" Content="Scan Projects" Click="Scan_Click"/>
     </Grid>
     <StackPanel Margin="4,0,4,2"><ProgressBar x:Name="FolderScanProgress" Height="8" Minimum="0" Maximum="100"/><TextBlock x:Name="FolderScanStatus" Text="Ready To Scan" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" FontSize="11"/></StackPanel>
     <WrapPanel Margin="2,0,2,6">
       <Button x:Name="CancelScanButton" Style="{StaticResource ToolbarButton}" Content="Cancel Scan" Click="CancelScan_Click" IsEnabled="False"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Storage Cleanup…" Click="Storage_Click" ToolTip="Storage folders and build cache cleanup"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Project Cleanup…" Click="ProjectCleanup_Click" ToolTip="Review redundant archive projects and backup files"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Share Source…" Click="ShareSource_Click" Background="#2563EB" ToolTip="Share the selected game's source files"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Share Playable Game…" Click="ShareGame_Click" Background="#2563EB" ToolTip="Share the selected game's built Windows output"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Share Both…" Click="ShareBoth_Click"/>
       <Button Style="{StaticResource ToolbarButton}" Content="Torrent Manager…" Click="TorrentCatalogue_Click"/>
     </WrapPanel>
   </StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="260"/></Grid.RowDefinitions>
     <DockPanel Grid.Column="0" Margin="0,0,10,10">
       <TextBlock DockPanel.Dock="Top" Text="Projects (tick games for batch repairs; select rows for build/run)" FontSize="16" FontWeight="SemiBold" Margin="4,0,0,8"/>
       <DataGrid x:Name="ProjectsGrid" AutoGenerateColumns="False" SelectionMode="Extended" IsReadOnly="True"
        Background="#1F2937" Foreground="#111827" RowBackground="#E5E7EB" AlternatingRowBackground="#D1D5DB"
        HeadersVisibility="Column" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="Repair" Width="65">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <CheckBox Foreground="#111827" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Tag="{Binding}" Loaded="RepairGameCheckBox_Loaded" Checked="RepairGameCheckBox_Changed"
                      Unchecked="RepairGameCheckBox_Changed"/>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTextColumn Header="Game / Project" Binding="{Binding Name}" Width="2*"/>
         <DataGridTextColumn Header="Framework" Binding="{Binding TargetFramework}" Width="*"/>
         <DataGridTextColumn Header="Platform" Binding="{Binding PlatformTarget}" Width="*"/>
         <DataGridTextColumn Header="Runtime" Binding="{Binding RuntimeIdentifier}" Width="*"/>
         <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
     </DockPanel>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="Build configuration" FontSize="16" FontWeight="SemiBold" Margin="4,0,0,10"/>
       <TextBlock Text="Action"/>
       <ComboBox x:Name="ActionBox" SelectedIndex="0"><ComboBoxItem Content="Build"/><ComboBoxItem Content="Rebuild"/><ComboBoxItem Content="Clean"/><ComboBoxItem Content="Restore"/></ComboBox>
       <TextBlock Text="Configuration"/>
       <ComboBox x:Name="ConfigBox" IsEditable="True" Text="Debug"><ComboBoxItem Content="Debug"/><ComboBoxItem Content="Release"/></ComboBox>
       <TextBlock Text="MSBuild Platform (solution/project platform)"/>
       <ComboBox x:Name="PlatformBox" IsEditable="True" Text="x64"><ComboBoxItem Content="x64"/><ComboBoxItem Content="x86"/><ComboBoxItem Content="AnyCPU"/></ComboBox>
       <TextBlock Text="PlatformTarget (compiler architecture)"/>
        <ComboBox x:Name="TargetBox" IsEditable="True" Text="x64">
            <ComboBoxItem Content="x64"/>
            <ComboBoxItem Content="x86"/>
            <ComboBoxItem Content="AnyCPU"/>
        </ComboBox>
        <TextBlock Text="Network Backend"/>
        <ComboBox x:Name="NetworkBackendBox" SelectedIndex="0">
        <ComboBoxItem Content="NetStub"/>
        <ComboBoxItem Content="Steamworks"/>
        <ComboBoxItem Content="LiteNetLib" IsEnabled="False"/>
        </ComboBox>
        
       <TextBlock Text="Target framework (optional override)"/>
       <TextBox x:Name="FrameworkBox" Text=""/>
       <TextBlock Text="Runtime identifier (optional override)"/>
       <TextBox x:Name="RuntimeBox" Text=""/>
       <TextBlock Text="DefineConstants (optional; semicolon-separated)"/>
       <TextBox x:Name="DefineConstantsBox" Text="" ToolTip="Example: STEAMWORKS_WIN;TRACE. Overrides evaluated constants when set."/>
       <TextBlock Text="Leave blank to use project-defined symbols. An override replaces existing constants." TextWrapping="Wrap" Foreground="#FBBF24" FontSize="11" Margin="4,0,4,8"/>
       <CheckBox x:Name="NoRestoreBox" Foreground="White" Margin="6"><CheckBox.Content><TextBlock Foreground="White" Text="Skip restore during build"/></CheckBox.Content></CheckBox>
       <CheckBox x:Name="UseVsBox" Foreground="White" Margin="6"><CheckBox.Content><TextBlock Foreground="White" Text="Use Visual Studio MSBuild (path below)"/></CheckBox.Content></CheckBox>
       <TextBox x:Name="MsbuildPathBox" Text="" ToolTip="Full path to MSBuild.exe"/>
       <WrapPanel>
        <Button Content="Inspect properties" Click="Inspect_Click"/>
        <Button Content="Detect Configuration Issues" Click="Detect_Click" Background="#2563EB"/>
        <Button Content="Run Build" Click="Build_Click"/>
        <Button x:Name="RunGameButton" Content="▶ Run Game" Width="120" Height="32" Margin="5,0" Click="RunGameButton_Click" ToolTip="Launch the selected compiled game" />
        <Button Content="Install GameLogger" Width="150" Height="32" Margin="5,0" Click="InstallGameLoggerButton_Click" />
        <Button Content="Cancel" Click="Cancel_Click"/>
       </WrapPanel>
       <TextBlock Text="Startup diagnostics" FontSize="16" FontWeight="SemiBold" Margin="4,16,0,4"/>
       <Button Content="Inject Startup Diagnostics" Click="InjectStartup_Click"/>
       <Button Content="Inject FNA Version Logging" Click="InjectFnaVersions_Click"/>
       <TextBlock Text="Adds framework, FNA3D, FAudio and SDL version logging to Main(). Creates a separate source backup; rebuild the game afterward." TextWrapping="Wrap" FontSize="11" Foreground="#9CA3AF" Margin="4"/>
       <TextBlock Text="Adds runtime and architecture Console.WriteLine calls to Main(). Creates a source backup." TextWrapping="Wrap" FontSize="11" Foreground="#9CA3AF" Margin="4"/>
       <WrapPanel Margin="4,10,4,2">
        <Button Content="Check all games" Click="SelectAllRepairGames_Click"/>
        <Button Content="Clear checks" Click="ClearRepairGames_Click"/>
       </WrapPanel>
       <TextBlock x:Name="RepairSelectionCount" Text="Games checked for repairs: 0" Margin="8,2" Foreground="#93C5FD"/>
       <Button Content="Batch XNA + SDK Fixes (checked games)" Click="BatchXnaFixes_Click" Background="#2563EB" Margin="4,12,4,4"/>
       <TextBlock Text="XNB Effect Conversion" FontSize="16" FontWeight="SemiBold" Margin="4,16,0,4"/>
       <TextBlock Text="Converts effects for the selected game rows (Content\Shaders if present, otherwise Content)." TextWrapping="Wrap" Foreground="#9CA3AF" Margin="4"/>
       <TextBlock Text="Convert-XnbEffects.ps1 path"/>
       <TextBox x:Name="EffectsScriptBox" Text="C:\PycharmProjects\xenia-game-manager\src\scripts\Convert-XnbEffects.ps1"/>
       <TextBlock Text="XnbExtractor.exe path"/>
       <TextBox x:Name="EffectsExtractorBox" Text="C:\source\xnb-extractor\bin\x64\Release\net9.0-windows\XnbExtractor.exe"/>
       <WrapPanel Margin="4,4,4,4">
        <CheckBox x:Name="EffectsRecurseBox" Foreground="White" IsChecked="True" Margin="6"><CheckBox.Content><TextBlock Foreground="White" Text="Recurse"/></CheckBox.Content></CheckBox>
        <CheckBox x:Name="EffectsOverwriteBox" Foreground="White" IsChecked="False" Margin="6"><CheckBox.Content><TextBlock Foreground="White" Text="Overwrite"/></CheckBox.Content></CheckBox>
       </WrapPanel>
       <Button Content="Convert XNB Effects (selected games)" Click="ConvertXnbEffects_Click" Background="#2563EB"/>
       <TextBlock Text="XNB Audio Conversion" FontSize="16" FontWeight="SemiBold" Margin="4,16,0,4"/>
       <TextBlock Text="Converts songs to Windows XNB + Ogg and sound effects to PCM Windows XNB. Includes audio in Songs, Sounds and directly under Content. Uses the XNB extractor path above. Backs up originals; rebuild games afterward." TextWrapping="Wrap" Foreground="#9CA3AF" Margin="4"/>
       <TextBlock Text="FFmpeg executable"/>
       <TextBox x:Name="AudioFfmpegBox"/>
       <Button Content="Convert XNB Audio (selected games)" Click="ConvertXnbAudio_Click" Background="#2563EB"/>
       <TextBlock Text="XACT Wave Bank Conversion" FontSize="16" FontWeight="SemiBold" Margin="4,16,0,4"/>
       <TextBlock Text="Converts supported .xwb banks throughout Content to PCM, preserving bank names, entry order and loop points. Creates backups and a report; skips banks already using Windows PCM. Compact banks are reported as unsupported. Rebuild games afterward." TextWrapping="Wrap" Foreground="#9CA3AF" Margin="4"/>
       <TextBlock Text="vgmstream executable"/>
       <TextBox x:Name="WaveBankDecoderBox"/>
       <Button Content="Convert Wave Banks (selected games)" Click="ConvertWaveBanks_Click" Background="#2563EB"/>
       <TextBlock Text="XNB Font Conversion" FontSize="16" FontWeight="SemiBold" Margin="4,16,0,4"/>
       <TextBlock Text="Finds SpriteFonts throughout Content and converts their embedded textures and glyph data to Windows XNB. Uses the XNB extractor path above. Backs up originals, repairs earlier conversions from backups and skips up-to-date fonts; rebuild games afterward." TextWrapping="Wrap" Foreground="#9CA3AF" Margin="4"/>
       <Button Content="Convert XNB Fonts (selected games)" Click="ConvertXnbFonts_Click" Background="#2563EB"/>
       <TextBlock Text="XNB Texture Conversion" FontSize="16" FontWeight="SemiBold" Margin="4,16,0,4"/>
       <TextBlock Text="Finds Texture2D assets throughout Content and converts supported Xbox textures to Windows XNB. Uses the XNB extractor path above. Backs up originals, repairs earlier conversions from backups and skips up-to-date textures; rebuild games afterward." TextWrapping="Wrap" Foreground="#9CA3AF" Margin="4"/>
       <Button Content="Convert XNB Textures (selected games)" Click="ConvertXnbTextures_Click" Background="#2563EB"/>
       <TextBlock Text="PowerShell fixer" FontSize="16" FontWeight="SemiBold" Margin="4,16,0,4"/>
       <TextBox x:Name="ScriptBox" Text="C:\PycharmProjects\xenia-game-manager\src\scripts\fix_sdk1005.ps1"/>
       <TextBlock Text="Script parameters (project path is passed as -ProjectName only if script supports it)" TextWrapping="Wrap" FontSize="11" Foreground="#9CA3AF" Margin="4"/>
       <Button Content="Run fixer for selected project" Click="Fixer_Click"/>
      </StackPanel>
     </ScrollViewer>
     <DockPanel Grid.Row="1" Grid.ColumnSpan="2">
       <StackPanel DockPanel.Dock="Top">
         <DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="View Torrents" Click="ViewTorrents_Click"/><Button x:Name="StopTorrentsButton" Content="Stop Torrents" Click="StopTorrents_Click" IsEnabled="False"/></WrapPanel><TextBlock x:Name="TorrentSummary" Text="No Active Torrents" Foreground="#93C5FD" TextWrapping="Wrap" Margin="4"/></DockPanel>
         <TextBlock x:Name="TorrentActivity" Foreground="#9CA3AF" Margin="4,0,4,4" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <TabControl x:Name="OutputTabs">
        <TabItem Header="Build Output">
       <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </TabItem>
        <TabItem Header="Torrents">
         <DataGrid x:Name="TorrentTransfersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#1F2937" Foreground="#111827" RowBackground="#E5E7EB" AlternatingRowBackground="#D1D5DB">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="2*"/>
           <DataGridTextColumn Header="Package" Binding="{Binding Kind}" Width="110"/>
           <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/>
           <DataGridTextColumn Header="Progress" Binding="{Binding ProgressDisplay}" Width="80"/>
           <DataGridTextColumn Header="Peers" Binding="{Binding Peers}" Width="55"/>
           <DataGridTextColumn Header="Download" Binding="{Binding DownloadDisplay}" Width="90"/>
           <DataGridTextColumn Header="Upload" Binding="{Binding UploadDisplay}" Width="90"/>
          </DataGrid.Columns>
         </DataGrid>
        </TabItem>
       </TabControl>
     </DockPanel>
   </Grid>
 </DockPanel>
</Window>
