<Project>
  <PropertyGroup>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'AnyCPU'">AnyCPU</PlatformTarget>
    <!-- Callers can pass PlatformTarget independently of Platform. Keep their
         assemblies separate, including Visual Studio's AnyCPU solution builds. -->
    <OutputPath>$(BaseOutputPath)$(Platform)\$(PlatformTarget)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Platform)\$(PlatformTarget)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
</Project>
