<Project>
  <PropertyGroup>
    <EnableXnaDllRedirect Condition="'$(EnableXnaDllRedirect)' == ''">false</EnableXnaDllRedirect>
    <XnaRedirectRoot>C:\source\Indie-Games-Core\tools\XnaAssemblyRedirector</XnaRedirectRoot>
    <XnaRedirectTool>$(XnaRedirectRoot)\bin\Release\net9.0\XnaAssemblyRedirector.dll</XnaRedirectTool>
    <XnaRedirectFna Condition="'$(XnaRedirectFna)' == ''">C:\source\Indie-Games-Core\FNA\bin\x64\Debug\net8.0\FNA.dll</XnaRedirectFna>
    <XnaRedirectStub Condition="'$(XnaRedirectStub)' == ''">C:\source\Indie-Games-Core\FNA.NetStub\bin\x64\Debug\net8.0-windows\FNA.NetStub.dll</XnaRedirectStub>
  </PropertyGroup>
  <Target Name="PatchLegacyXnaReferences" BeforeTargets="ResolveAssemblyReferences" Condition="('$(EnableXnaDllRedirect)' == 'true' or '@(_LegacySunBurnReference)' != '') and Exists('$(MSBuildProjectDirectory)\584E07D1')">
    <PropertyGroup>
      <AssemblySearchPaths>{HintPathFromItem};$(AssemblySearchPaths)</AssemblySearchPaths>
      <_XnaPatchedFolder>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)XnaRedirect</_XnaPatchedFolder>
    </PropertyGroup>
    <Error Condition="!Exists('$(XnaRedirectTool)')" Text="XNA redirector missing: $(XnaRedirectTool)" />
    <ItemGroup>
      <_SharedSunBurnAssembly Include="@(_ResolvedProjectReferencePaths-&gt;WithMetadataValue('Filename', 'SynapseGaming-SunBurn-Pro'))" />
    </ItemGroup>
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(XnaRedirectRoot)\Invoke-XnaRedirect.ps1&quot; -InputFolder &quot;$(MSBuildProjectDirectory)\584E07D1&quot; -OutputFolder &quot;$(_XnaPatchedFolder)&quot; -ToolDll &quot;$(XnaRedirectTool)&quot; -FnaDll &quot;$(XnaRedirectFna)&quot; -StubDll &quot;$(XnaRedirectStub)&quot; -ReplacementDll &quot;@(_SharedSunBurnAssembly)&quot;" />
    <ItemGroup>
      <Reference Update="@(Reference)" Condition="Exists('$(_XnaPatchedFolder)\%(Reference.Identity).dll')">
        <HintPath>$(_XnaPatchedFolder)\%(Reference.Identity).dll</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>
</Project>